rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents (only owner can read/write) ──────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── ATS History (owner only) ────────────────────────────────────────────
    match /ats_history/{docId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Job Applications (owner only) ───────────────────────────────────────
    match /job_applications/{docId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Resumes (owner only) ────────────────────────────────────────────────
    match /resumes/{docId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Notifications (owner only) ──────────────────────────────────────────
    match /notifications/{docId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Global Job Cache (any authenticated user can read; write allowed) ───
    // Jobs are shared across all users to reduce API calls.
    // Write is allowed to any authenticated user so the first fetcher caches
    // results for everyone else.
    match /global_jobs/{cacheId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Catch-all: deny everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
